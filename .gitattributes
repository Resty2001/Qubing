# Default: normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows command scripts may use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unity / C# text files
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf

# Unity serialized text assets
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Common binary assets - never perform line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.dll binary
*.zip binary
*.7z binary